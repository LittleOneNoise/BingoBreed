<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Racine des logs : propriété système `bingobreed.projectDir`, injectée par
        `desktopApp/build.gradle.kts` (= racine du repo). Repli sur `.` (cwd du process) si absente,
        ex. lancement direct hors Gradle — reste "interne au projet" tant qu'on lance depuis la racine.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${bingobreed.projectDir:-.}/logs/sniffer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${bingobreed.projectDir:-.}/logs/sniffer.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Notre code -->
    <logger name="fr.lilone.bingobreed" level="DEBUG"/>
    <!-- pcap4j est bavard : on le limite -->
    <logger name="org.pcap4j" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
